{
  "expo": {
    "name": "AjedrezPro",
    "slug": "AjedrezPro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ajedrezpro-icon-v2.png",
    "scheme": "ajedrezpro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ajedrezpro-ios-icon-1024.png",
      "bundleIdentifier": "com.kepabilbao.ajedrezpro",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07150F",
        "foregroundImage": "./assets/images/ajedrezpro-icon-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kepabilbao.ajedrezpro",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07150F",
          "image": "./assets/images/ajedrezpro-icon-v2.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2288f86-5373-4e91-910c-992f58c7bb87"
      }
    }
  }
}
